@startuml
skinparam backgroundColor #FFFFFF
skinparam rectangle {
  BackgroundColor #F1F5F9
  BackgroundColor<<ext>> #FDF3E7
  BackgroundColor<<gear>> #F8FAFC
  BackgroundColor<<fw>> #F8FAFC
  BackgroundColor<<l4>> #F8FAFC
  BorderColor #475569
  BorderColor<<ext>> #B7791F
  BorderColor<<gear>> #94A3B8
  BorderColor<<fw>> #8A6210
  BorderColor<<l4>> #1F6FD0
  FontColor #1B2635
}
skinparam package {
  BorderColor #94A3B8
  BackgroundColor transparent
  FontColor #475569
}
title Gateway Platform — 인바운드/아웃바운드 FLOW
' flowcast source: flowcast 합성 예제 (topology, network-nat 프리셋: IP/VIP/NAT/포트 방화벽 표기)
package "DMZ" {
  rectangle "web1\n10.0.1.11" as web1
}
package "내부망" {
  rectangle "app1\n10.0.2.21" as app1
}
rectangle "Client" as client <<ext>>
rectangle "Edge Firewall\n공인 203.0.113.10" as fw_edge <<fw>>
rectangle "Ingress VIP\n10.0.0.10" as vip_in <<l4>>
rectangle "Egress VIP\n10.0.0.20" as vip_out <<l4>>
rectangle "Partner API" as partner <<ext>>


client --> fw_edge : 1
fw_edge --> vip_in : 2
vip_in --> web1 : 3
web1 --> app1 : 4
app1 --> vip_out : 5
vip_out --> partner : 6

legend
|= # |= 설명 |
| 1 | 인바운드 요청\n( HTTPS 443, 허용 443 ) |
| 2 | 방화벽 통과\n( DNAT 203.0.113.10:443 → 10.0.0.10:443 ) |
| 3 | VIP 분배\n( TCP, 10.0.0.10 → 백엔드 풀 ) |
| 4 | 내부 호출\n( AJP 9109, 허용 9109 ) |
| 5 | 아웃바운드 요청 |
| 6 | SNAT 통과\n( SNAT 10.0.0.0/16 → 203.0.113.30 ) |
end legend
@enduml
